"use client";

import { useState } from "react";

import Sidebar from "@/components/Sidebar";
import PreviewPanel from "@/components/PreviewPanel";

export default function DashboardPage() {
  const [images, setImages] = useState<string[]>([]);

  const captions = [
    "Street food isn't just food.",
    "Every corner has a story.",
    "From spicy bites to sweet delights.",
    "It's the flavors that unite us.",
    "Tag your foodie crew.",
  ];

  const handleImages = (
    e: React.ChangeEvent<HTMLInputElement>
  ) => {
    const files = e.target.files;

    if (!files) return;

    const urls = Array.from(files).map((file) =>
      URL.createObjectURL(file)
    );

    setImages(urls);
  };

  return (
    <main className="min-h-screen bg-[#0a0a0a] text-white p-6">
      <div className="max-w-[1600px] mx-auto">
        <div className="grid grid-cols-12 gap-6">
          <Sidebar />

          <div className="col-span-4 bg-[#111111] rounded-3xl p-5 border border-zinc-800">
            <h2 className="text-4xl font-bold mb-6">
              Upload Images
            </h2>

            <input
              type="file"
              multiple
              accept="image/*"
              onChange={handleImages}
              className="mb-6"
            />

            <div className="grid grid-cols-2 gap-4">
              {images.map((img, index) => (
                <div
                  key={index}
                  className="aspect-[4/5] rounded-2xl overflow-hidden"
                >
                  <img
                    src={img}
                    alt=""
                    className="w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>

          <PreviewPanel
            images={images}
            captions={captions}
          />
        </div>
      </div>
    </main>
  );
}